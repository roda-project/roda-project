module Config
  class << self
    def get
      @config ||= {
        secret: ENV["SESSION_SECRET"] || 'DEV-ONLY-8<FQF8HiF)>l0hbPk£vBQ#IrYsoO}14k\l+-/gIU[j}l0hbPk£vBQ#IrY',
        environment:,
      }
    end

    def not_production? = environment != "production"
    def environment
      ENV["RACK_ENV"] || "development"
    end
  end
end
