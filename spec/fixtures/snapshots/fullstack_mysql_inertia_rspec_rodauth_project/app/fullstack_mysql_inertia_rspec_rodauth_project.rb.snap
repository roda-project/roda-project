class FullstackMysqlInertiaRspecRodauthProject < Roda
  # Routing
  plugin :hash_branch_view_subdir
  plugin :autoload_hash_branches
  HASH_BRANCHES.each { |args| autoload_hash_branch_dir(*args) }

  plugin :all_verbs
  plugin :not_found
  
  # Views
  plugin :partials, views: "app/views"
  plugin :render, **Config.get[:render]
  plugin :content_for, append: false
  plugin :flash
  plugin :assets_manifest
  plugin :inertia,
    version: assets_version,
    layout: {
      head: [
        '<meta http-equiv="x-ua-compatible" content="ie=edge">',
        css_entrypoint_tag(:app)
      ].join,
      body: js_entrypoint_tag(:app)
    }
  
  # Request / Response
  plugin :halt
  plugin :json
  plugin :exception_page
  plugin :caching
  plugin :cookies
  plugin :default_headers
  plugin :content_security_policy do |csp|
    # csp.default_src :none
    # csp.img_src :self
    # csp.style_src :self
    # csp.script_src :self
    # csp.font_src :self
    # csp.form_action :self
    # csp.base_uri :none
    # csp.frame_ancestors :none
    # csp.block_all_mixed_content
  end

  # CSRF Protection
  plugin :route_csrf

  # Other
  plugin :common_logger, Providers::Logger.get
  plugin :json_parser
  plugin :sessions, secret: Config.get[:secret]
  plugin :i18n, **Config.get[:i18n]

  # Authentication
  plugin :rodauth do
    enable :login, :logout, :create_account, :verify_account

    accounts_table :accounts
    password_hash_table :account_password_hashes
    use_database_authentication_functions? false
    # base_url "http://localhost:9292"
    login_column :email
    # Redirect logged in users to the wherever login redirects to
    already_logged_in { redirect "/" }

    hmac_secret Config.get[:hmac_secret]
  end

  def config = @config ||= Config.get

  route do |r|
    r.i18n_set_locale_from(:http)
    r.hash_branches
    
    r.rodauth
    
    r.root do
      inertia("Index")
    end
  end

  error do |e|
    if Config.not_production?
      puts e
      next exception_page(e, css_file: "/public/exception_page.css")
    end
  end

  not_found do
    "not found"
  end
end
