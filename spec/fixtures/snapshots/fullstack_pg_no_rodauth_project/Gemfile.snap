# frozen_string_literal: true

source "https://rubygems.org"

# Base
gem "roda"
gem "roda-i18n"
gem "zeitwerk"

# Database
gem "sequel"
gem "pg"

# Web Server
gem "puma"
# gem "falcon"
# gem 'iodine'
# gem 'thin'

# Views
gem 'roda-assets_manifest'

# Performance
gem "oj"
# gem 'async'

# Security
# gem "rack-attack"

# Misc
gem "mail"
gem "bcrypt"
gem "logger"
group :development do
  gem "thor"
  gem "guard-puma"
  gem "guard-livereload"
  gem "rack-livereload"
  gem "rack-test"
  gem "debug"
  gem "base64"
  gem "standard"
  gem "rspec"
end
