# frozen_string_literal: true

source "https://rubygems.org"

# Base
gem "roda"
gem "roda-i18n"
gem "zeitwerk"
<% if context.rodauth? %>
# Authentication
gem "rodauth"
gem "jwt"
<% end %><% if context.database? %>
# Database
gem "sequel"
<%= "gem \"#{context.db_gem}\"" %>
<% end %>
# Web Server
gem "puma"
# gem "falcon"
# gem 'iodine'
# gem 'thin'<% if context.fullstack? %>

# Views
gem 'roda-assets_manifest'
<% end %>
# Performance
gem "oj"
# gem 'async'

# Security
# gem "rack-attack"

# Misc
gem "mail"
gem "bcrypt"
gem "logger"
group :development do
  gem "thor"
  gem "guard-puma"
  gem "guard-livereload"
  gem "rack-livereload"
  gem "rack-test"
  gem "debug"
  gem "base64"
  gem "standard"<% if context.minitest? %>
  gem "minitest"
  gem "minitest-hooks"
<% else %>
  gem "rspec"<% end %>
end
